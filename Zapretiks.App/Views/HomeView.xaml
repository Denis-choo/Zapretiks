<UserControl x:Class="Zapretiks.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="IntegrationParts.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanVisibility" />
            <Style x:Key="ConfiguredContent" TargetType="StackPanel">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding HasConfiguredFolder}" Value="True">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="WelcomeContent" TargetType="StackPanel">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding HasConfiguredFolder}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="RuntimeIndicator" TargetType="Ellipse">
                <Setter Property="Width" Value="8" />
                <Setter Property="Height" Value="8" />
                <Setter Property="Fill" Value="{StaticResource SubtleBrush}" />
                <Setter Property="Margin" Value="0,12,10,0" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                        <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsStatusWarning}" Value="True">
                        <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsCheckingStatus}" Value="True">
                        <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.05*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <Border Background="{StaticResource SurfaceQuietBrush}" BorderBrush="{StaticResource SubtleBorderBrush}"
                BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          PanningMode="VerticalOnly">
                <StackPanel Margin="28,26,28,28" MaxWidth="570">
                    <StackPanel Style="{StaticResource WelcomeContent}">
                        <TextBlock AutomationProperties.HeadingLevel="Level1" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource PageTitleText}">
                                    <Setter Property="Text" Value="{DynamicResource Home.WelcomeTitle}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasProfiles}" Value="True">
                                            <Setter Property="Text" Value="{DynamicResource Home.ReturningTitle}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Margin="0,13,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
                                    <Setter Property="Text" Value="{DynamicResource Home.ExampleNote}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasProfiles}" Value="True">
                                            <Setter Property="Text" Value="{DynamicResource Home.ReturningNote}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <WrapPanel Margin="0,23,0,0">
                            <Button Margin="0,0,7,7">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                        <Setter Property="Content" Value="{DynamicResource Home.TryExample}" />
                                        <Setter Property="Command" Value="{Binding OpenCatalogCommand}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasProfiles}" Value="True">
                                                <Setter Property="Content" Value="{DynamicResource Home.Library}" />
                                                <Setter Property="Command" Value="{Binding OpenLibraryCommand}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="{DynamicResource Home.CreateProfile}" Command="{Binding CreateProfileCommand}"
                                    Style="{StaticResource SecondaryButton}" Margin="0,0,0,7" />
                        </WrapPanel>
                        <Button Content="{DynamicResource Home.TryExample}" Command="{Binding OpenCatalogCommand}"
                                HorizontalAlignment="Left" Margin="0,5,0,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasProfiles}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    <StackPanel Style="{StaticResource ConfiguredContent}">
                        <TextBlock Text="{DynamicResource Home.Title}" Style="{StaticResource PageTitleText}"
                                   AutomationProperties.HeadingLevel="Level1" Margin="0,0,0,24" />
                        <TextBlock Text="{DynamicResource Home.Integration}" Style="{StaticResource SectionTitleText}"
                                   AutomationProperties.HeadingLevel="Level2" />
                        <TextBlock Text="{Binding IntegrationTitle}" Style="{StaticResource WorkspaceRowDetail}" Margin="0,11,0,0" />
                        <TextBlock Text="{Binding FolderDisplay}" ToolTip="{Binding FolderDisplay}" TextTrimming="CharacterEllipsis"
                                   Style="{StaticResource CaptionText}" Margin="0,6,0,0" />
                        <WrapPanel Margin="0,15,0,0">
                            <Button Content="{DynamicResource Home.ChangeFolder}" Command="{Binding ChooseFolderCommand}"
                                    Style="{StaticResource SecondaryButton}" Margin="0,0,6,6" />
                            <Button Content="{DynamicResource Home.IntegrationSettings}" Command="{Binding OpenSettingsCommand}"
                                    Style="{StaticResource GhostButton}" Margin="0,0,0,6" />
                        </WrapPanel>
                        <Border BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="0,1,0,0"
                                Margin="0,21,0,0" Padding="0,20,0,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Home.Library}" Style="{StaticResource SectionTitleText}"
                                           AutomationProperties.HeadingLevel="Level2" />
                                <TextBlock Text="{DynamicResource Home.LibraryEmpty}" Margin="0,10,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasProfiles}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ItemsControl ItemsSource="{Binding RecentProfileTitles}" Margin="0,8,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Style="{StaticResource BodyText}"
                                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                                       Margin="0,2,0,0" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <WrapPanel Margin="0,15,0,0">
                                    <Button Content="{DynamicResource Home.GoToLibrary}" Command="{Binding OpenLibraryCommand}"
                                            Style="{StaticResource SecondaryButton}" Margin="0,0,6,6" />
                                    <Button Content="{DynamicResource Home.GoToCatalog}" Command="{Binding OpenCatalogCommand}"
                                            Style="{StaticResource GhostButton}" Margin="0,0,0,6" />
                                </WrapPanel>
                                <Button Content="{DynamicResource Home.PreviewChanges}" Command="{Binding OpenPreviewCommand}"
                                        Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Column="1" Background="{DynamicResource WorkspaceBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          PanningMode="VerticalOnly">
                <StackPanel Margin="28,26,28,28" MaxWidth="560">
                    <StackPanel Style="{StaticResource WelcomeContent}">
                        <TextBlock Text="{DynamicResource Home.SetupTitle}" Style="{StaticResource SectionTitleText}"
                                   AutomationProperties.HeadingLevel="Level2" />
                        <TextBlock Text="{DynamicResource Home.SetupNote}" Style="{StaticResource BodyText}" Margin="0,13,0,0" />
                        <Button Content="{DynamicResource Home.ConnectFolder}" Command="{Binding ChooseFolderCommand}"
                                Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,20,0,0" />
                    </StackPanel>

                    <StackPanel Style="{StaticResource ConfiguredContent}">
                        <TextBlock Text="{DynamicResource Home.Runtime}" Style="{StaticResource SectionTitleText}"
                                   AutomationProperties.HeadingLevel="Level2" Margin="0,0,0,16" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Style="{StaticResource RuntimeIndicator}" />
                            <TextBlock Grid.Column="1" Text="{Binding StatusText}" Foreground="{StaticResource TextBrush}"
                                       AutomationProperties.LiveSetting="Polite" FontFamily="{StaticResource DisplayFont}"
                                       FontSize="28" FontWeight="Bold" LineHeight="35" TextWrapping="Wrap" />
                        </Grid>
                        <TextBlock Text="{Binding StatusDetail}" Style="{StaticResource BodyText}" Margin="18,8,0,0" />
                        <TextBlock Text="{DynamicResource Home.Strategy}" Style="{StaticResource WorkspaceRowTitle}"
                                   Margin="0,24,0,0" />
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StrategyPickerTemplate}"
                                        HorizontalContentAlignment="Stretch" Margin="0,8,0,0" />
                        <WrapPanel Margin="0,14,0,0">
                            <Button Content="Запустить zapret" Command="{Binding StartCommand}" Margin="0,0,8,6">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasManagedRun}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="Сменить стратегию" Command="{Binding SwitchCommand}"
                                    Visibility="{Binding ShowSwitch, Converter={StaticResource BooleanVisibility}}"
                                    Style="{StaticResource PrimaryButton}" Margin="0,0,8,6" />
                            <Button Content="Остановить zapret" Command="{Binding StopCommand}"
                                    Visibility="{Binding HasManagedRun, Converter={StaticResource BooleanVisibility}}"
                                    Style="{StaticResource SecondaryButton}" Margin="0,0,8,6" />
                            <Button Content="Перезапустить zapret" Command="{Binding RestartCommand}"
                                    Visibility="{Binding HasManagedRun, Converter={StaticResource BooleanVisibility}}"
                                    Style="{StaticResource GhostButton}" Margin="0,0,8,6" />
                        </WrapPanel>
                        <WrapPanel Margin="0,10,0,0">
                            <Button Content="{DynamicResource Home.RefreshStatus}" Command="{Binding RefreshStatusCommand}"
                                    Style="{StaticResource GhostButton}" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding StatusCheckedAt}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                        </WrapPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
