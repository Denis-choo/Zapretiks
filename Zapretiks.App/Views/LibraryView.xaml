<UserControl x:Class="Zapretiks.App.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Zapretiks.App.Views">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="PageParts.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="PopulatedLibraryToolbar" TargetType="WrapPanel">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding HasItems}" Value="False">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="{DynamicResource SurfaceQuietBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.94*" MinWidth="330" />
            <ColumnDefinition Width="1.06*" />
        </Grid.ColumnDefinitions>

        <Grid Margin="27,28,24,21" IsEnabled="{Binding IsBrowsing}">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasItems}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,17">
                <TextBlock Text="{DynamicResource Shell.Library}" Style="{DynamicResource PageTitleText}"
                           AutomationProperties.HeadingLevel="Level1" Margin="0,0,0,19" />
                <WrapPanel Style="{StaticResource PopulatedLibraryToolbar}">
                    <Button Content="{DynamicResource Library.Create}" Command="{Binding CreateCommand}"
                            Style="{DynamicResource SecondaryButton}" Margin="0,0,6,6" />
                    <Button Content="{DynamicResource Library.Import}" Command="{Binding ImportCommand}"
                            Style="{DynamicResource GhostButton}" Margin="0,0,5,6"
                            AutomationProperties.Name="{DynamicResource Library.ImportName}" />
                </WrapPanel>
                <Button Content="{DynamicResource Library.ShowPreview}" Command="{Binding ClearSelectionCommand}"
                        HorizontalAlignment="Left" Margin="-9,0,0,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasItems}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>

            <Border Grid.Row="1" Style="{StaticResource ProfileListFrame}" VerticalAlignment="Top">
                <ListBox x:Name="ProfilesList" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                         SelectionChanged="OnProfileSelected" Style="{StaticResource ProfileList}"
                         ItemTemplate="{StaticResource ProfileListRow}" AutomationProperties.Name="{DynamicResource Library.List}" />
            </Border>
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="2,14,0,0" AutomationProperties.LiveSetting="Polite">
                <TextBlock Style="{StaticResource PageMetadata}" Text="{DynamicResource Library.Count}" Margin="0,0,5,0" />
                <TextBlock Style="{StaticResource PageMetadata}" Text="{Binding Items.Count}" />
            </StackPanel>
        </Grid>

        <Border Background="{DynamicResource WorkspaceBrush}"
                BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1,0,0,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Grid.Column" Value="1" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasItems}" Value="False">
                            <Setter Property="Grid.Column" Value="0" />
                            <Setter Property="Grid.ColumnSpan" Value="2" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <ScrollViewer x:Name="DetailScroll" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <Grid Margin="32,30,30,32" MaxWidth="600">
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasItems}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="{DynamicResource Library.WelcomeTitle}" Style="{DynamicResource PageTitleText}"
                                       TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level2" />
                            <TextBlock Text="{DynamicResource Library.WelcomeHint}" Style="{DynamicResource BodyText}"
                                       Margin="0,10,0,22" />
                            <Button Content="{DynamicResource Library.CreateFirst}" Command="{Binding CreateCommand}"
                                    Style="{DynamicResource PrimaryButton}" HorizontalAlignment="Left" />
                            <Button Content="{DynamicResource Library.OpenCatalog}" Command="{Binding OpenCatalogCommand}"
                                    Style="{DynamicResource GhostButton}" HorizontalAlignment="Left" Margin="-9,10,0,0" />
                            <Expander Header="{DynamicResource Library.HaveFile}" Style="{DynamicResource TechnicalDisclosure}" Foreground="{DynamicResource MutedBrush}"
                                      Margin="0,21,0,0" FontSize="14">
                                <StackPanel Margin="0,9,0,0">
                                    <TextBlock Text="{DynamicResource Library.ImportHint}" Style="{DynamicResource BodyText}" />
                                    <Button Content="{DynamicResource Library.Import}" Command="{Binding ImportCommand}"
                                            Style="{DynamicResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,10,0,0"
                                            AutomationProperties.Name="{DynamicResource Library.ImportName}" />
                                </StackPanel>
                            </Expander>
                        </StackPanel>

                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowPreview}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <views:ConfigurationPreviewView />
                        </StackPanel>

                        <StackPanel Style="{StaticResource ProfileDetailPage}">
                            <ContentControl Content="{Binding SelectedItem}" ContentTemplate="{StaticResource ProfileIntro}"
                                            HorizontalContentAlignment="Stretch" Focusable="False" />

                            <StackPanel Margin="0,5,0,17">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedItem.IsDemo}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="{Binding SelectedItem.StateLabel}" Foreground="{DynamicResource MutedBrush}"
                                           FontSize="14" Margin="0,0,0,10" />
                                <Button Content="{Binding SelectedItem.ToggleLabel}" Command="{Binding ToggleCommand}"
                                        CommandParameter="{Binding SelectedItem}" HorizontalAlignment="Left" Margin="0,0,0,7">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedItem.IsEnabled}" Value="True">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="{DynamicResource Library.Review}" Command="{Binding ReviewChangesCommand}"
                                        HorizontalAlignment="Left">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedItem.IsEnabled}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                            <StackPanel Margin="0,5,0,18">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedItem.IsDemo}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Button Content="{DynamicResource Library.CreateFirst}" Command="{Binding CreateCommand}"
                                        Style="{DynamicResource PrimaryButton}" HorizontalAlignment="Left" />
                            </StackPanel>

                            <TextBlock Style="{StaticResource PageNotice}" Text="{Binding StatusMessage}"
                                       AutomationProperties.LiveSetting="Polite" />

                            <WrapPanel Margin="0,0,0,16">
                                <Button Content="{DynamicResource Library.Edit}" Command="{Binding EditCommand}" Margin="0,0,6,4">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CanEditSelected}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="{DynamicResource Profile.Export}" Command="{Binding ExportCommand}"
                                        CommandParameter="{Binding SelectedItem}" Style="{DynamicResource GhostButton}"
                                        Margin="0,0,6,4" />
                                <Button Content="{DynamicResource Profile.RemoveShort}" Command="{Binding RemoveCommand}"
                                        CommandParameter="{Binding SelectedItem}" Style="{DynamicResource DangerButton}"
                                        AutomationProperties.Name="{DynamicResource Profile.Remove}" Margin="0,0,0,4" />
                            </WrapPanel>
                            <ContentControl Content="{Binding SelectedItem}" ContentTemplate="{StaticResource ProfileDetails}"
                                            HorizontalContentAlignment="Stretch" Focusable="False" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <views:ProfileEditorView IsVisibleChanged="OnEditorVisibilityChanged">
                    <views:ProfileEditorView.Style>
                        <Style TargetType="views:ProfileEditorView">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </views:ProfileEditorView.Style>
                </views:ProfileEditorView>
            </Grid>
        </Border>
    </Grid>
</UserControl>
