<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="PageContent" TargetType="StackPanel">
        <Setter Property="MaxWidth" Value="1136" />
        <Setter Property="Margin" Value="32,26,32,32" />
    </Style>
    <Style x:Key="PageMetadata" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="PageGlyph" TargetType="Image">
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style x:Key="PageCommand" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style x:Key="PageRowLink" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="0,4,12,4" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Outline" BorderBrush="Transparent" BorderThickness="1" Background="Transparent"
                            Padding="{TemplateBinding Padding}" CornerRadius="3">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Outline" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="CollectionPanel" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{DynamicResource SurfaceQuietBrush}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>
    <Style x:Key="CollectionHeader" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="13,0,12,0" />
        <Setter Property="MinHeight" Value="34" />
    </Style>
    <Style x:Key="CollectionRow" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="12,3,12,3" />
        <Setter Property="MinHeight" Value="43" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="TableHeading" TargetType="TextBlock" BasedOn="{StaticResource PageMetadata}">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,10,0" />
    </Style>
    <Style x:Key="TableCell" TargetType="TextBlock" BasedOn="{StaticResource PageMetadata}">
        <Setter Property="Margin" Value="1,0,11,0" />
    </Style>
    <Style x:Key="EmptyArea" TargetType="Border">
        <Setter Property="Padding" Value="15,13" />
        <Setter Property="Background" Value="{DynamicResource SurfaceQuietBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasItems}" Value="False">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="PageNotice" TargetType="TextBlock" BasedOn="{StaticResource PageMetadata}">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,0,0,9" />
        <Style.Triggers>
            <Trigger Property="Text" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="ProfileListing" TargetType="StackPanel">
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding SelectedItem}" Value="{x:Null}">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="ProfileDetailPage" TargetType="StackPanel">
        <Style.Triggers>
            <DataTrigger Binding="{Binding SelectedItem}" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="RecordText" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
    </Style>
    <Style x:Key="ProfileListItem" TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="13,10,12,10" />
        <Setter Property="MinHeight" Value="55" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid Background="Transparent">
                        <Border x:Name="Row" Background="{DynamicResource SurfaceBrush}" Padding="{TemplateBinding Padding}"
                                BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,0,0,1">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                        <Border x:Name="SelectionMark" Background="{DynamicResource AccentBrush}"
                                HorizontalAlignment="Left" Width="2" Margin="0,4" CornerRadius="1"
                                Visibility="Collapsed" IsHitTestVisible="False" />
                        <Border x:Name="KeyboardOutline" BorderBrush="{DynamicResource FocusBrush}" BorderThickness="1"
                                Visibility="Collapsed" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource AccentSurfaceBrush}" />
                            <Setter TargetName="SelectionMark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="KeyboardOutline" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ProfileList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource ProfileListItem}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ScrollViewer Focusable="False" CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                                  HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                  VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                        <ItemsPresenter />
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ProfileListFrame" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasItems}" Value="False">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <DataTemplate x:Key="ProfileListRow">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="22" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
            </Grid.ColumnDefinitions>
            <Image Width="17" Height="17" VerticalAlignment="Center" HorizontalAlignment="Left">
                <Image.Style>
                    <Style TargetType="Image">
                        <Setter Property="Source" Value="{DynamicResource Icon.Profile}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CategoryLabel}" Value="Игры">
                                <Setter Property="Source" Value="{DynamicResource Icon.Games}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Image.Style>
            </Image>
            <StackPanel Grid.Column="1" Margin="6,0,10,0">
                <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextBrush}"
                           FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Margin="0,3,0,0" TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource PageMetadata}">
                            <Setter Property="Text" Value="{Binding CategoryLabel}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                    <Setter Property="Text" Value="{Binding StateLabel}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
            <Image Grid.Column="2" Width="13" Height="13" VerticalAlignment="Center"
                   Source="{DynamicResource Icon.Chevron}" Opacity="0.75" />
        </Grid>
    </DataTemplate>
    <DataTemplate x:Key="ProfileIntro">
        <StackPanel>
            <TextBlock Style="{DynamicResource PageTitleText}" Text="{Binding Title}" TextWrapping="Wrap"
                       AutomationProperties.HeadingLevel="Level1" />
            <TextBlock Style="{DynamicResource BodyText}" Text="{Binding Description}" TextWrapping="Wrap" Margin="0,5,0,13" />
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource PageMetadata}" Text="{Binding CategoryLabel}" Margin="0,0,12,0" />
                <TextBlock Style="{StaticResource PageMetadata}" Text="{Binding VerificationLabel}" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="ProfileDetails">
        <StackPanel>
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,1" Padding="0,11" Margin="0,0,17,0">
                <UniformGrid Columns="2">
                    <StackPanel Margin="0,0,12,10">
                        <TextBlock Style="{StaticResource PageMetadata}" Text="{DynamicResource Profile.Author}" />
                        <TextBlock Text="{Binding Author}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Margin="0,0,12,10">
                        <TextBlock Style="{StaticResource PageMetadata}" Text="{DynamicResource Profile.Version}" />
                        <TextBlock Text="{Binding Version}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Style="{StaticResource PageMetadata}" Text="{DynamicResource Profile.Source}" />
                        <TextBlock Text="{Binding SourceLabel}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Style="{StaticResource PageMetadata}" Text="{DynamicResource Profile.Updated}" />
                        <TextBlock Text="{Binding UpdatedLabel}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </UniformGrid>
            </Border>
            <TextBlock Text="{DynamicResource Profile.Details}" Style="{DynamicResource SectionTitleText}"
                       AutomationProperties.HeadingLevel="Level2" Margin="0,0,0,8" />
            <TextBox Text="{Binding DetailsText, Mode=OneWay}" Style="{StaticResource RecordText}" MaxHeight="330"
                     AutomationProperties.Name="{DynamicResource Profile.Details}" />
            <TextBlock Text="{DynamicResource Profile.Compatibility}" Style="{DynamicResource SectionTitleText}"
                       AutomationProperties.HeadingLevel="Level2" Margin="0,17,0,5" />
            <TextBlock Text="{Binding CompatibilityLabel}" Style="{DynamicResource BodyText}" TextWrapping="Wrap" />
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
