<UserControl x:Class="Zapretiks.App.Views.GamesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{DynamicResource SurfaceQuietBrush}">
        <Grid Margin="28,24,28,20" MaxWidth="960">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <DockPanel>
                <Button DockPanel.Dock="Right" Command="{Binding ScanCommand}" VerticalAlignment="Center"
                        Margin="20,0,0,0" Content="{Binding ScanLabel}" Style="{DynamicResource PrimaryButton}" />
                <TextBlock Text="{DynamicResource Shell.Games}" Style="{DynamicResource PageTitleText}"
                           AutomationProperties.HeadingLevel="Level1" />
            </DockPanel>
            <TextBlock Grid.Row="1" Margin="0,12,0,18" Text="{Binding StatusMessage}" Style="{DynamicResource BodyText}"
                       AutomationProperties.LiveSetting="Polite" />
            <ListBox Grid.Row="2" ItemsSource="{Binding Games}" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Установленные игры">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,0,0,1" Padding="8,10">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" Style="{DynamicResource SmallTitleText}"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding AppIdLabel}" />
                                <TextBlock Text="{Binding InstallPath}" Style="{DynamicResource CaptionText}"
                                           Margin="0,4,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding InstallPath}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</UserControl>
