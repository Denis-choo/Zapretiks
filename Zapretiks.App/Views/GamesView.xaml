<UserControl x:Class="Zapretiks.App.Views.GamesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <UserControl.Resources>
        <sys:String x:Key="Games.WorkspaceTitle">Библиотеки Steam</sys:String>
        <sys:String x:Key="Games.ResultsEmpty">Список пока пуст</sys:String>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.04*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Background="{StaticResource SurfaceQuietBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="{DynamicResource Shell.Games}" Style="{StaticResource PageTitleText}"
                       AutomationProperties.HeadingLevel="Level1" Margin="26,24,26,18" TextWrapping="Wrap" />

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          PanningMode="VerticalOnly">
                <Border Style="{StaticResource CardBorder}" Padding="0" Margin="26,0,26,26"
                        VerticalAlignment="Top">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Games}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="0,0,0,1"
                                            Padding="12,10" MinHeight="58">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,10,0">
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource EmphasisText}"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding InstallPath}" />
                                                <TextBlock Text="{Binding LibraryPath}" Style="{StaticResource CaptionText}"
                                                           Margin="0,4,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding LibraryPath}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding AppIdLabel}" Style="{StaticResource CaptionText}"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{StaticResource Games.ResultsEmpty}" Padding="12,14">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasItems}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>

        <Border Grid.Column="1" Background="{StaticResource WorkspaceBrush}" BorderBrush="{StaticResource SubtleBorderBrush}"
                BorderThickness="1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" PanningMode="VerticalOnly">
                <Grid>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="326" Margin="26,30">
                        <Border Width="58" Height="58" CornerRadius="17" Background="{StaticResource AccentSurfaceBrush}"
                                HorizontalAlignment="Center">
                            <Image Source="{StaticResource Icon.Games}" Width="26" Height="26" Focusable="False"
                                   IsHitTestVisible="False" />
                        </Border>
                        <TextBlock Text="{StaticResource Games.WorkspaceTitle}" Style="{StaticResource SectionTitleText}"
                                   FontSize="23" TextAlignment="Center" Margin="0,15,0,0"
                                   AutomationProperties.HeadingLevel="Level2" />
                        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource BodyText}" TextAlignment="Center"
                                   Margin="0,9,0,0" AutomationProperties.LiveSetting="Polite" />
                        <Button Command="{Binding ScanCommand}" HorizontalAlignment="Center" MinWidth="160" MinHeight="38"
                                Margin="0,18,0,0" AutomationProperties.Name="{DynamicResource Games.ScanName}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                    <Setter Property="Content" Value="{DynamicResource Games.Scan}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                            <Setter Property="IsEnabled" Value="False" />
                                            <Setter Property="Content" Value="{DynamicResource Games.Scanning}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <ProgressBar Height="2" Width="160" HorizontalAlignment="Center" Margin="0,9,0,0"
                                     Foreground="{StaticResource AccentBrush}" Background="{StaticResource AccentSurfaceBrush}"
                                     Minimum="0" Maximum="1" Value="1">
                            <ProgressBar.Style>
                                <Style TargetType="ProgressBar">
                                    <Setter Property="Visibility" Value="Hidden" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsScanning}" Value="True" />
                                                <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="IsIndeterminate" Value="True" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ProgressBar.Style>
                        </ProgressBar>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
