<UserControl x:Class="Zapretiks.App.Views.CatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Find" Executed="FocusSearch" CanExecute="CanFocusSearch" />
    </UserControl.CommandBindings>
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="PageParts.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="CategoryTab" TargetType="TabItem">
                <Setter Property="Padding" Value="10,7" />
                <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Grid>
                                <Border x:Name="TabFace" CornerRadius="5" Background="Transparent"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter ContentSource="Header" VerticalAlignment="Center"
                                                      TextElement.Foreground="{TemplateBinding Foreground}" />
                                </Border>
                                <Border x:Name="FocusLine" CornerRadius="5" BorderThickness="1"
                                        BorderBrush="Transparent" IsHitTestVisible="False" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="TabFace" Property="Background" Value="{DynamicResource HoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="TabFace" Property="Background" Value="{DynamicResource AccentSurfaceBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource AccentSoftBrush}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="FocusLine" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <DataTemplate x:Key="CatalogRow">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextBrush}"
                                   FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Description}" Style="{StaticResource PageMetadata}"
                                   TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxHeight="38" LineHeight="19"
                                   FontSize="13" Margin="0,4,0,0" ToolTip="{Binding Description}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" VerticalAlignment="Top" Margin="0,2,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                        <Setter Property="Text" Value="{DynamicResource Catalog.Saved}" />
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Setter Property="Foreground" Value="{DynamicResource AccentSoftBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SharesLocalId}" Value="True">
                                        <Setter Property="Text" Value="{DynamicResource Catalog.Saved}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="{DynamicResource SurfaceQuietBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.94*" MinWidth="330" />
            <ColumnDefinition Width="1.06*" />
        </Grid.ColumnDefinitions>

        <Grid Margin="27,28,24,21">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,17">
                <DockPanel Margin="0,0,0,12">
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource PageMetadata}" Margin="12,5,0,0"
                               Text="{Binding Items.Count, StringFormat='Найдено · {0}'}"
                               AutomationProperties.LiveSetting="Polite" />
                    <TextBlock Text="{DynamicResource Shell.Catalog}" Style="{DynamicResource PageTitleText}"
                               AutomationProperties.HeadingLevel="Level1" />
                </DockPanel>
                <TextBlock Text="{DynamicResource Catalog.ExamplesNote}" Margin="0,0,0,15">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasOnlyExamples}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Grid>
                    <TextBox x:Name="SearchField" Padding="34,5,36,5"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="{DynamicResource Catalog.SearchName}"
                             ToolTip="Поиск по названию, описанию или адресу (Ctrl+F)" />
                    <TextBlock Style="{DynamicResource FluentIcon}" Text="{DynamicResource Glyph.Search}"
                               Foreground="{DynamicResource MutedBrush}" Margin="12,0,0,0" FontSize="15"
                               HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" />
                    <TextBlock Text="{DynamicResource Catalog.SearchHint}" IsHitTestVisible="False"
                               VerticalAlignment="Center" Margin="34,0,10,0" Foreground="{DynamicResource SubtleBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchField}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center" Margin="2" Width="32" Height="32"
                            MinHeight="0" Padding="0" Content="&#xE8BB;" FontFamily="{DynamicResource GlyphFont}"
                            Click="ClearSearch" AutomationProperties.Name="Очистить поиск" ToolTip="Очистить поиск">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchField}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
                <Grid Margin="0,11,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TabControl ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                                VerticalAlignment="Center" ItemContainerStyle="{StaticResource CategoryTab}"
                                FontSize="13" AutomationProperties.Name="{DynamicResource Catalog.Category}">
                        <TabControl.Template>
                            <ControlTemplate TargetType="TabControl">
                                <TabPanel IsItemsHost="True" KeyboardNavigation.TabNavigation="Once" />
                            </ControlTemplate>
                        </TabControl.Template>
                    </TabControl>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource, Mode=TwoWay}"
                              Margin="7,0,0,0" MaxWidth="168" HorizontalAlignment="Right" Padding="8,5,5,5"
                              AutomationProperties.Name="{DynamicResource Catalog.PublicationName}">
                        <ComboBox.Style>
                            <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSourceFilter}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.Style>
                    </ComboBox>
                </Grid>
            </StackPanel>
            <Border Grid.Row="1" Style="{StaticResource ProfileListFrame}" VerticalAlignment="Top">
                <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                         SelectionChanged="OnProfileSelected" Style="{StaticResource ProfileList}"
                         ItemTemplate="{StaticResource CatalogRow}" AutomationProperties.Name="{DynamicResource Catalog.List}" />
            </Border>
            <Border Grid.Row="1" Style="{StaticResource EmptyArea}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Catalog.Empty}" Style="{DynamicResource BodyText}" />
                    <TextBlock Text="{DynamicResource Catalog.EmptyHint}" Style="{DynamicResource BodyText}" Margin="0,5,0,0" />
                    <Button Content="{DynamicResource Catalog.Reset}" Command="{Binding ResetFiltersCommand}" Click="OnFiltersReset"
                            HorizontalAlignment="Left" Margin="0,12,0,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasFilters}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <TextBlock Style="{StaticResource PageNotice}" Text="{Binding StatusMessage}" Margin="0,10,0,0"
                               AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Column="1" Background="{DynamicResource WorkspaceBrush}"
                BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1,0,0,0">
            <Grid>
                <ScrollViewer x:Name="DetailScroll" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                    <StackPanel Margin="32,30,30,32" MaxWidth="600" Style="{StaticResource ProfileDetailPage}">
                        <ContentControl Content="{Binding SelectedItem}" ContentTemplate="{StaticResource ProfileIntro}"
                                        HorizontalContentAlignment="Stretch" Focusable="False" />
                        <WrapPanel Margin="0,2,0,20">
                            <Button Content="{DynamicResource Catalog.OpenProfile}" Command="{Binding OpenInLibraryCommand}" Margin="0,0,0,4">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedItem.IsInstalled}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button HorizontalAlignment="Left" MinWidth="90"
                                    Command="{Binding InstallCommand}" CommandParameter="{Binding SelectedItem}" Margin="0,0,0,4">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                        <Setter Property="Content" Value="{DynamicResource Catalog.AddProfile}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedItem.IsInstalled}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SelectedItem.SharesLocalId}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </WrapPanel>
                        <TextBlock Text="{DynamicResource Catalog.LocalVersionExists}" Margin="0,0,0,12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedItem.SharesLocalId}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Style="{StaticResource PageNotice}" Text="{Binding StatusMessage}"
                                   AutomationProperties.LiveSetting="Polite" />
                        <ContentControl Content="{Binding SelectedItem}" ContentTemplate="{StaticResource ProfileDetails}"
                                        HorizontalContentAlignment="Stretch" Focusable="False" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
