<UserControl x:Class="Zapretiks.App.Views.CatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="PageParts.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="{DynamicResource SurfaceQuietBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.94*" MinWidth="330" />
            <ColumnDefinition Width="1.06*" />
        </Grid.ColumnDefinitions>

        <Grid Margin="25,24,22,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,15">
                <TextBlock Text="{DynamicResource Shell.Catalog}" Style="{DynamicResource PageTitleText}"
                           AutomationProperties.HeadingLevel="Level1" Margin="0,0,0,14" />
                <Grid>
                    <TextBox x:Name="SearchField" Padding="34,5,10,5"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="{DynamicResource Catalog.SearchName}" />
                    <Image Style="{StaticResource PageGlyph}" Source="{DynamicResource Icon.Search}" Margin="11,0,0,0"
                           HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" />
                    <TextBlock Text="{DynamicResource Catalog.SearchHint}" IsHitTestVisible="False"
                               VerticalAlignment="Center" Margin="34,0,10,0" Foreground="{DynamicResource SubtleBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchField}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1.13*" />
                    </Grid.ColumnDefinitions>
                    <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                              Margin="0,0,7,0" AutomationProperties.Name="{DynamicResource Catalog.Category}" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource, Mode=TwoWay}"
                              AutomationProperties.Name="{DynamicResource Catalog.PublicationName}" />
                </Grid>
            </StackPanel>
            <Border Grid.Row="1" Style="{StaticResource ProfileListFrame}" VerticalAlignment="Top">
                <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                         SelectionChanged="OnProfileSelected" Style="{StaticResource ProfileList}"
                         ItemTemplate="{StaticResource ProfileListRow}" AutomationProperties.Name="{DynamicResource Catalog.List}" />
            </Border>
            <Border Grid.Row="1" Style="{StaticResource EmptyArea}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Catalog.Empty}" Style="{DynamicResource BodyText}" />
                    <Button Content="{DynamicResource Catalog.Reset}" Command="{Binding ResetFiltersCommand}" Click="OnFiltersReset"
                            Style="{DynamicResource GhostButton}" HorizontalAlignment="Left" Margin="-8,8,0,0" />
                </StackPanel>
            </Border>
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,11,0,0" AutomationProperties.LiveSetting="Polite">
                <TextBlock Style="{StaticResource PageMetadata}" Text="{DynamicResource Pages.Found}" Margin="0,0,6,0" />
                <TextBlock Style="{StaticResource PageMetadata}" Text="{Binding Items.Count}" />
            </StackPanel>
        </Grid>

        <Border Grid.Column="1" Background="{DynamicResource WorkspaceBrush}"
                BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1,0,0,0">
            <Grid>
                <ScrollViewer x:Name="DetailScroll" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                    <StackPanel Margin="29,26,28,28" MaxWidth="600" Style="{StaticResource ProfileDetailPage}">
                        <ContentControl Content="{Binding SelectedItem}" ContentTemplate="{StaticResource ProfileIntro}"
                                        HorizontalContentAlignment="Stretch" Focusable="False" />
                        <Button Content="{Binding SelectedItem.InstallLabel}" HorizontalAlignment="Left" MinWidth="116"
                                Command="{Binding InstallCommand}" CommandParameter="{Binding SelectedItem}" Margin="0,4,0,17">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedItem.IsInstalled}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <TextBlock Style="{StaticResource PageNotice}" Text="{Binding StatusMessage}"
                                   AutomationProperties.LiveSetting="Polite" />
                        <ContentControl Content="{Binding SelectedItem}" ContentTemplate="{StaticResource ProfileDetails}"
                                        HorizontalContentAlignment="Stretch" Focusable="False" />
                    </StackPanel>
                </ScrollViewer>
                <StackPanel Style="{StaticResource ProfileListing}" VerticalAlignment="Center" HorizontalAlignment="Center"
                            MaxWidth="290" Margin="28" IsHitTestVisible="False">
                    <Image Source="{DynamicResource Icon.Catalog}" Width="32" Height="32" Opacity="0.72"
                           HorizontalAlignment="Center" Margin="0,0,0,13" />
                    <TextBlock Text="{DynamicResource Catalog.SelectProfile}" Style="{DynamicResource SectionTitleText}"
                               TextAlignment="Center" TextWrapping="Wrap" />
                    <TextBlock Text="{DynamicResource Catalog.SelectProfileHint}" Style="{DynamicResource BodyText}"
                               TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0" />
                    <TextBlock Style="{StaticResource PageNotice}" Text="{Binding StatusMessage}"
                               TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
