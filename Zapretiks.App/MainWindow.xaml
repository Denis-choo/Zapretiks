<Window x:Class="Zapretiks.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:Zapretiks.App.ViewModels"
        xmlns:views="clr-namespace:Zapretiks.App.Views"
        Title="Zapretiks" Width="1100" Height="730" MinWidth="850" MinHeight="470"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Icon="Assets/Zapretiks.ico" Style="{StaticResource {x:Type Window}}" Language="ru-RU">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="35" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BooleanVisibility" />
            <DataTemplate DataType="{x:Type vm:HomeViewModel}"><views:HomeView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:CatalogViewModel}"><views:CatalogView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:LibraryViewModel}"><views:LibraryView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:GamesViewModel}"><views:GamesView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView /></DataTemplate>

            <Style x:Key="NavigationTab" TargetType="Button" BasedOn="{StaticResource GhostButton}">
                <Setter Property="Command" Value="{Binding NavigateCommand}" />
                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                <Setter Property="Height" Value="40" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="ToolTipService.InitialShowDelay" Value="380" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid Background="Transparent">
                                <Border x:Name="TabBackground" CornerRadius="6"
                                        Background="Transparent" BorderBrush="Transparent" BorderThickness="1" />
                                <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                           FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0" />
                                <Border x:Name="TabIndicator" Width="2" Height="17" Margin="-1,0,0,0"
                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                        CornerRadius="1" Visibility="Collapsed"
                                        Background="{StaticResource AccentBrush}" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="TabBackground" Property="Background" Value="{StaticResource HoverBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                </Trigger>
                                <Trigger Property="AutomationProperties.ItemStatus" Value="Выбран">
                                    <Setter TargetName="TabIndicator" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="TabBackground" Property="Background" Value="{StaticResource AccentSurfaceBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource AccentSoftBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="TabBackground" Property="Background" Value="{StaticResource PressedBrush}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="TabBackground" Property="BorderBrush" Value="{StaticResource FocusBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="CaptionButton" TargetType="Button" BasedOn="{StaticResource ChromeButton}">
                <Setter Property="Width" Value="44" />
                <Setter Property="Height" Value="35" />
                <Setter Property="ToolTipService.InitialShowDelay" Value="600" />
            </Style>

            <Style x:Key="WorkspacePresenter" TargetType="ContentControl">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ContentControl">
                            <Border Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{StaticResource CanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="35" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="136" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <Border Grid.ColumnSpan="2" Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Zapretiks" Foreground="{StaticResource TextBrush}"
                               VerticalAlignment="Center" FontSize="14" FontWeight="Bold" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="MinimizeWindow"
                            AutomationProperties.Name="{DynamicResource Shell.Minimize}" ToolTip="{DynamicResource Shell.Minimize}" />
                    <Button Click="ToggleMaximized">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource CaptionButton}">
                                <Setter Property="Content" Value="&#xE922;" />
                                <Setter Property="AutomationProperties.Name" Value="{DynamicResource Shell.Maximize}" />
                                <Setter Property="ToolTip" Value="{DynamicResource Shell.Maximize}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                        <Setter Property="Content" Value="&#xE923;" />
                                        <Setter Property="AutomationProperties.Name" Value="{DynamicResource Shell.Restore}" />
                                        <Setter Property="ToolTip" Value="{DynamicResource Shell.Restore}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Style="{StaticResource CaptionButton}" Tag="Close" Content="&#xE8BB;" Click="CloseWindow"
                            AutomationProperties.Name="{DynamicResource Shell.Close}" ToolTip="{DynamicResource Shell.Close}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="NavigationBar" Grid.Row="1" Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="0,0,1,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsOnboarding}" Value="True">
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid x:Name="NavigationPanel" Margin="7,17" KeyboardNavigation.DirectionalNavigation="Cycle">
                <Grid.RowDefinitions>
                    <RowDefinition Height="44" />
                    <RowDefinition Height="44" />
                    <RowDefinition Height="44" />
                    <RowDefinition Height="44" />
                    <RowDefinition />
                    <RowDefinition Height="44" />
                </Grid.RowDefinitions>
                <Button Content="{DynamicResource Shell.Home}" CommandParameter="Home"
                        ToolTip="{DynamicResource Shell.Home}" AutomationProperties.Name="{DynamicResource Shell.Home}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource NavigationTab}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedPageKey}" Value="Home">
                                    <Setter Property="AutomationProperties.ItemStatus" Value="Выбран" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Grid.Row="1" Content="{DynamicResource Shell.Catalog}" CommandParameter="Catalog"
                        ToolTip="{DynamicResource Shell.Catalog}" AutomationProperties.Name="{DynamicResource Shell.Catalog}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource NavigationTab}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedPageKey}" Value="Catalog">
                                    <Setter Property="AutomationProperties.ItemStatus" Value="Выбран" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Grid.Row="2" Content="{DynamicResource Shell.Library}" CommandParameter="Library"
                        ToolTip="{DynamicResource Shell.Library}" AutomationProperties.Name="{DynamicResource Shell.Library}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource NavigationTab}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedPageKey}" Value="Library">
                                    <Setter Property="AutomationProperties.ItemStatus" Value="Выбран" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Grid.Row="3" Content="{DynamicResource Shell.Games}" CommandParameter="Games"
                        ToolTip="{DynamicResource Shell.Games}" AutomationProperties.Name="{DynamicResource Shell.Games}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource NavigationTab}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedPageKey}" Value="Games">
                                    <Setter Property="AutomationProperties.ItemStatus" Value="Выбран" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Grid.Row="5" Content="{DynamicResource Shell.Settings}" CommandParameter="Settings"
                        ToolTip="{DynamicResource Shell.Settings}" AutomationProperties.Name="{DynamicResource Shell.Settings}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource NavigationTab}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedPageKey}" Value="Settings">
                                    <Setter Property="AutomationProperties.ItemStatus" Value="Выбран" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Grid.Column="1" ClipToBounds="True" Background="{StaticResource CanvasBrush}">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsOnboarding}" Value="True">
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <ContentControl x:Name="PageHost" Style="{StaticResource WorkspacePresenter}" />
            <ContentControl x:Name="AlternatePageHost" Style="{StaticResource WorkspacePresenter}" Visibility="Collapsed" />
        </Grid>

        <Grid x:Name="OnboardingOverlay" Grid.Row="1" Grid.ColumnSpan="2" Panel.ZIndex="4"
              Visibility="{Binding IsOnboarding, Converter={StaticResource BooleanVisibility}}"
              IsVisibleChanged="FocusOnboarding" Background="#A8000000"
              KeyboardNavigation.TabNavigation="Cycle">
            <Grid.InputBindings>
                <KeyBinding Key="Escape" Command="{Binding SkipOnboardingCommand}" />
            </Grid.InputBindings>
            <Border Width="450" MaxWidth="510" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                    CornerRadius="12" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Onboarding.Title}" Style="{StaticResource SectionTitleText}"
                               AutomationProperties.HeadingLevel="Level1" />
                    <TextBlock Text="{DynamicResource Onboarding.Body}" Style="{StaticResource BodyText}" Margin="0,9,0,0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                        <Button Content="{DynamicResource Onboarding.Skip}" Command="{Binding SkipOnboardingCommand}" Margin="0,0,8,0" />
                        <Button x:Name="OnboardingChooseButton" Content="{DynamicResource Common.ChooseFolder}"
                                Command="{Binding ChooseFolderCommand}" Style="{StaticResource PrimaryButton}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="1" Grid.Column="1" Panel.ZIndex="5" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                MaxWidth="470" Margin="18" Background="{StaticResource SurfaceRaisedBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Notice}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                        <DataTrigger Binding="{Binding Notice}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <Border DockPanel.Dock="Left" Width="3">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding NoticeKind}" Value="Success"><Setter Property="Background" Value="{StaticResource SuccessBrush}" /></DataTrigger>
                                <DataTrigger Binding="{Binding NoticeKind}" Value="Warning"><Setter Property="Background" Value="{StaticResource WarningBrush}" /></DataTrigger>
                                <DataTrigger Binding="{Binding NoticeKind}" Value="Error"><Setter Property="Background" Value="{StaticResource ErrorBrush}" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE8BB;"
                        Width="30" Height="30" Margin="2,4,4,4" Command="{Binding DismissNoticeCommand}"
                        AutomationProperties.Name="{DynamicResource Shell.Dismiss}" ToolTip="{DynamicResource Shell.Dismiss}" />
                <TextBlock Text="{Binding Notice}" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"
                           VerticalAlignment="Center" Margin="11,8" AutomationProperties.LiveSetting="Polite" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
